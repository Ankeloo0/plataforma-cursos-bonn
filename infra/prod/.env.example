# ─────────────────────────────────────────────────────────────
# Variables del entorno de PRODUCCIÓN (servidor de la empresa).
# Copia este archivo como `.env` en esta misma carpeta y CAMBIA TODOS los valores secretos.
# El archivo `.env` NUNCA se sube al repositorio.
# ─────────────────────────────────────────────────────────────

# Puerto por el que se entra a la plataforma (http://<servidor>:8200) [P-30]
HTTP_PORT=8200

# PostgreSQL (solo accesible dentro de la red interna de Docker)
DB_HOST=db
DB_PORT=5432
DB_NAME=capacitacion_bonn
DB_USER=bonn_app
DB_PASSWORD=GENERAR-CON-openssl-rand-base64-32

# Autenticación (genera con: openssl rand -base64 48)
JWT_SECRET=GENERAR-CON-openssl-rand-base64-48
JWT_EXPIRES_IN=8h
# Cambiar a true cuando el servidor tenga HTTPS [P-30]
COOKIE_SECURE=false

# Inicio de sesion (P-21): bloqueo tras N intentos fallidos y limite de peticiones por IP
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15
LOGIN_LIMITE_POR_MINUTO=10

CORS_ORIGIN=

STORAGE_LOCAL_PATH=/storage

# Documentacion de la API (/api/docs): apagada en produccion
SWAGGER_ENABLED=false

TZ=America/Mexico_City

# Superusuario que crea el seed en la instalación (docker compose ... exec api npm run seed).
# La contraseña es temporal: se pide cambiarla al entrar. Mínimo 8 caracteres, con letra y número.
# Después de crear el superusuario puedes borrar estos valores.
SUPERUSER_USERNAME=
SUPERUSER_PASSWORD=
SUPERUSER_NOMBRES=
SUPERUSER_APELLIDO_PATERNO=
SUPERUSER_APELLIDO_MATERNO=

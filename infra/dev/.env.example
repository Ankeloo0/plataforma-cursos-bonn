# ─────────────────────────────────────────────────────────────
# Variables del entorno de DESARROLLO.
# Copia este archivo como `.env` en esta misma carpeta y cambia los valores.
# El archivo `.env` NUNCA se sube al repositorio.
# ─────────────────────────────────────────────────────────────

# Puertos publicados en tu equipo (solo accesibles desde localhost)
DB_PORT_HOST=5450
API_PORT_HOST=3200
WEB_PORT_HOST=5200

# PostgreSQL (dentro de Docker la API se conecta al servicio "db" por el puerto interno 5432)
DB_HOST=db
DB_PORT=5432
DB_NAME=capacitacion_bonn
DB_USER=bonn_app
DB_PASSWORD=cambia-esta-contrasena

# Autenticación (mínimo 32 caracteres; genera uno con: openssl rand -base64 48)
JWT_SECRET=cambia-este-secreto-por-uno-de-al-menos-32-caracteres
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false

# Inicio de sesion (P-21): bloqueo tras N intentos fallidos y limite de peticiones por IP
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15
LOGIN_LIMITE_POR_MINUTO=10

# Vacío = sin CORS (Vite redirige /api, así que el navegador ve un solo origen)
CORS_ORIGIN=

# Archivos
STORAGE_LOCAL_PATH=/storage

# Documentacion de la API en /api/docs (solo desarrollo)
SWAGGER_ENABLED=true

TZ=America/Mexico_City

# Superusuario que crea el seed (npm run seed). La contraseña es temporal: se cambia al entrar.
# Política: mínimo 8 caracteres, con al menos una letra y un número.
SUPERUSER_USERNAME=superusuario
SUPERUSER_PASSWORD=Bonn2026temporal
SUPERUSER_NOMBRES=Superusuario
SUPERUSER_APELLIDO_PATERNO=Plataforma
SUPERUSER_APELLIDO_MATERNO=

# Si al guardar un archivo del frontend no se recarga el navegador, cámbialo a true
VITE_USE_POLLING=false

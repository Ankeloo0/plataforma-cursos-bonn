# ─────────────────────────────────────────────────────────────
# SOLO si ejecutas la API fuera de Docker (npm run start:dev en tu equipo).
# Con Docker no se usa este archivo: las variables vienen de infra/dev/.env.
# Copia como `backend/.env`. Requiere la base de datos de Docker levantada:
#   docker compose -f infra/dev/docker-compose.yml up -d db
# ─────────────────────────────────────────────────────────────
PORT=3200
DB_HOST=localhost
DB_PORT=5450
DB_NAME=capacitacion_bonn
DB_USER=bonn_app
DB_PASSWORD=la-misma-de-infra/dev/.env
JWT_SECRET=cambia-este-secreto-por-uno-de-al-menos-32-caracteres
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false

# Inicio de sesion (P-21): bloqueo tras N intentos fallidos y limite de peticiones por IP
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15
LOGIN_LIMITE_POR_MINUTO=10
CORS_ORIGIN=
STORAGE_LOCAL_PATH=./storage-local

# Documentacion de la API en /api/docs (solo desarrollo)
SWAGGER_ENABLED=true
TZ=America/Mexico_City

# Superusuario que crea el seed (npm run seed). La contraseña es temporal: se cambia al entrar.
# Política: mínimo 8 caracteres, con al menos una letra y un número.
SUPERUSER_USERNAME=superusuario
SUPERUSER_PASSWORD=Bonn2026temporal
SUPERUSER_NOMBRES=Superusuario
SUPERUSER_APELLIDO_PATERNO=Grupo Bonn
SUPERUSER_APELLIDO_MATERNO=
